# ─────────────────────────────────────────────
# Copy this file to .env.local at the repo ROOT and fill values.
# NEVER commit .env.local to git.
# Both apps (portfolio :3000, admin :3001) read from this one file.
# ─────────────────────────────────────────────

# ── Neon PostgreSQL ──────────────────────────
# DATABASE_URL  = pooled connection string (…-pooler.…neon.tech), used at runtime
# DIRECT_URL    = direct connection string (no -pooler), used by prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Neon Auth (Managed Better Auth) ──────────
# Neon Console → your project → Auth → Configuration.
# NEON_AUTH_BASE_URL  = the "Auth URL" (…/neondb/auth)
# NEON_AUTH_COOKIE_SECRET = any 32+ char secret — generate: openssl rand -base64 32
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32"

# Comma-separated allowlist — only these emails can create/use the admin panel.
# (Neon Auth allows open sign-up; this gates who can actually edit.)
ADMIN_EMAILS="abarnasivakumar15@gmail.com"

# ── Vercel Blob (résumé + image uploads) ─────
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ── Anthropic Claude API (optional AI assistant) ──
ANTHROPIC_API_KEY="sk-ant-..."

# ── App URLs ─────────────────────────────────
NEXT_PUBLIC_PORTFOLIO_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
