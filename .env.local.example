# ─────────────────────────────────────────────
# Copy this file to .env.local at the repo ROOT and fill values.
# NEVER commit .env.local to git.
# Both apps (portfolio :3000, admin :3001) read from this one file.
# ─────────────────────────────────────────────

# ── Neon PostgreSQL ──────────────────────────
# DATABASE_URL  = pooled connection string (…-pooler.…neon.tech), used at runtime
# DIRECT_URL    = direct connection string (no -pooler), used by prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Neon Auth (Stack Auth) ───────────────────
# Enable "Auth" on your Neon project → copy these three values.
# Required to build & run the admin app.
NEXT_PUBLIC_STACK_PROJECT_ID="00000000-0000-0000-0000-000000000000"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="pck_..."
STACK_SECRET_SERVER_KEY="ssk_..."

# Comma-separated allowlist — only these emails can access the admin panel.
# (Neon Auth may allow open sign-up; this gates who can actually edit.)
ADMIN_EMAILS="abarnasivakumar15@gmail.com"

# ── Vercel Blob (résumé + image uploads) ─────
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ── Anthropic Claude API (optional AI assistant) ──
ANTHROPIC_API_KEY="sk-ant-..."

# ── App URLs ─────────────────────────────────
NEXT_PUBLIC_PORTFOLIO_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
