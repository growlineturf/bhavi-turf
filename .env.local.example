# ─────────────────────────────────────────────
# Copy this file to .env.local and fill values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-..."

# Admin auth
ADMIN_PASSWORD="your-secure-password-here"
ADMIN_SESSION_SECRET="generate-a-long-random-secret"

# Vercel Blob (for resume + image uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Upstash Redis (for caching)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# App URLs
NEXT_PUBLIC_PORTFOLIO_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
